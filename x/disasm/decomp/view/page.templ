package view

import "github.com/lewtec/lewkit/x/http/asset/daisyui"
import "github.com/lewtec/lewkit/x/http/asset/tailwindcss"

templ previewDocument(page previewPage) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Title }</title>
			@daisyui.Load()
			@tailwindcss.Load()
		</head>
		<body>
			<div class="navbar bg-base-200">
				<div class="navbar-start">
					<a class="btn btn-ghost text-lg" href="/" title={ page.Project }>{ page.ProjectName }</a>
				</div>
				<div class="navbar-end">
					<button type="button" id="cmdpalette-open" class="btn btn-sm" aria-haspopup="dialog" aria-controls="cmdpalette" title="Jump (Ctrl+K or ⌘K)">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						Jump
						<kbd id="cmdpalette-hotkey" class="kbd kbd-xs">Ctrl+K</kbd>
					</button>
				</div>
			</div>
			<main class="max-w-6xl mx-auto flex flex-col gap-4 p-4">
			<h1 class="text-2xl font-semibold">{ page.Heading }</h1>
			if page.Notice != "" {
				<div role="alert" class="alert">{ page.Notice }</div>
			}
			if page.Comment != "" {
				<p class="text-base-content/70">{ page.Comment }</p>
			}
			if page.NameAction != "" {
				<form method="post" action={ templ.URL(page.NameAction) }>
					<fieldset class="fieldset max-w-xl">
						<label class="label">Function name</label>
						<input class="input w-full" name="name" value={ page.FunctionName }/>
						<button class="btn" type="submit">Save name</button>
					</fieldset>
				</form>
			}
			if page.SignatureAction != "" {
				<form method="post" action={ templ.URL(page.SignatureAction) }>
					<fieldset class="fieldset max-w-xl">
						<label class="label">Signature</label>
						<input class="input w-full" name="signature" value={ page.Signature }/>
						<button class="btn" type="submit">Save signature</button>
					</fieldset>
				</form>
			}
			if len(page.Callees) > 0 {
				<h2 class="text-lg font-semibold">Calls</h2>
				<ul class="menu menu-sm max-w-md rounded-box bg-base-200">
					for _, row := range page.Callees {
						<li><a href={ templ.URL(row.Href) }>{ row.Label }</a></li>
					}
				</ul>
			}
			if page.NoteAction != "" {
				<h2 class="text-lg font-semibold">Notes</h2>
				<form method="post" action={ templ.URL(page.NoteAction) }>
					<input type="hidden" name="next" value={ page.Next }/>
					<fieldset class="fieldset max-w-xl">
						<label class="label">Address</label>
						<input class="input w-full font-mono" name="address" value={ page.AddressText }/>
						<label class="label">What it means</label>
						<input class="input w-full" name="text" value={ page.AddressNote }/>
						<button class="btn" type="submit">Save note</button>
					</fieldset>
				</form>
				if len(page.Notes) > 0 {
					<ul class="list max-w-3xl rounded-box bg-base-200">
						for _, note := range page.Notes {
							<li class="list-row">
								if note.Href != "" {
									<a class="link font-mono" href={ templ.URL(note.Href) }>{ note.Address }</a>
								} else {
									<code class="font-mono">{ note.Address }</code>
								}
								<span>{ note.Text }</span>
							</li>
						}
					</ul>
				}
			}
			if page.StreamHref != "" {
				<p><a class="link" href={ templ.URL(page.StreamHref) }>Instructions</a></p>
			}
			if page.Summary != "" {
				<pre class="overflow-x-auto rounded-box bg-base-200 p-4 font-mono text-sm">{ page.Summary }</pre>
			}
			if len(page.Rows) > 0 {
				<div class="overflow-x-auto">
					<table class="table table-sm">
						<tbody>
							for _, row := range page.Rows {
								<tr>
									<td>
										if row.Href != "" {
											<a class="link" href={ templ.URL(row.Href) }>{ row.Label }</a>
										} else {
											{ row.Label }
										}
									</td>
									<td class="font-mono">{ row.Detail }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			if len(page.Assembly) > 0 {
				<div class="card bg-base-200">
					<div class="card-body">
						<h2 class="card-title">{ page.AssemblyHeading }</h2>
						@assemblyListing(page.Assembly)
					</div>
				</div>
			}
			if page.SourceAction != "" {
				<h2 class="text-lg font-semibold">Source</h2>
				<p class="text-base-content/70">The source held for this function. check stores a candidate when the blocks agree.</p>
				<form method="post" action={ templ.URL(page.SourceAction) }>
					<fieldset class="fieldset">
						<textarea class="textarea w-full font-mono" name="source" rows="14" spellcheck="false">{ page.Source }</textarea>
						<button class="btn" type="submit">Save source</button>
					</fieldset>
				</form>
			}
			</main>
			<dialog id="cmdpalette" class="modal" data-cmdpalette="" aria-label="Jump to">
				<div class="modal-box max-w-lg p-0">
					<div class="flex items-center gap-2 border-b border-base-300 px-3 py-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="opacity-40"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<input id="cmdpalette-input" type="search" class="input input-ghost w-full" placeholder="Jump to…" autocomplete="off" spellcheck="false" aria-autocomplete="list" aria-controls="cmdpalette-list" aria-activedescendant=""/>
						<kbd class="kbd kbd-xs">esc</kbd>
					</div>
					<ul id="cmdpalette-list" role="listbox" class="menu menu-sm max-h-80 w-full flex-nowrap overflow-y-auto">
						for _, item := range page.Items {
							<li role="option" data-cmd-item data-keywords={ item.Keywords } aria-selected="false">
								<a href={ templ.URL(item.Href) } class="flex flex-col items-start" tabindex="-1">
									if item.Group != "" {
										<span class="text-xs uppercase tracking-wide opacity-60">{ item.Group }</span>
									}
									<span class="font-mono">{ item.Label }</span>
								</a>
							</li>
						}
					</ul>
					<p id="cmdpalette-empty" class="hidden p-4 text-center text-sm opacity-60">No matches</p>
					<div class="flex flex-wrap items-center gap-3 border-t border-base-300 px-3 py-2 text-xs opacity-60">
						<span><kbd class="kbd kbd-xs">↑↓</kbd> move</span>
						<span><kbd class="kbd kbd-xs">↵</kbd> open</span>
						<span><kbd class="kbd kbd-xs">esc</kbd> close</span>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop"><button>close</button></form>
			</dialog>
			@palette()
		</body>
	</html>
}
