name: {{.Product}}
options:
  deploymentTarget:
    iOS: "17.0"
  createIntermediateGroups: true
settings:
  base:
    IPHONEOS_DEPLOYMENT_TARGET: "17.0"
    SWIFT_VERSION: "5.0"
    GENERATE_INFOPLIST_FILE: NO
    INFOPLIST_FILE: Info.plist
    TARGETED_DEVICE_FAMILY: "1,2"
    CODE_SIGN_IDENTITY: "-"
    CODE_SIGNING_REQUIRED: NO
    CODE_SIGNING_ALLOWED: YES
    AD_HOC_CODE_SIGNING_ALLOWED: YES
    DEVELOPMENT_TEAM: ""
    ENABLE_BITCODE: NO
    ENABLE_DEBUG_DYLIB: NO
    SWIFT_OBJC_BRIDGING_HEADER: Sources/eletrocromo-Bridging-Header.h
    CODE_SIGN_ENTITLEMENTS: App.entitlements
    OTHER_LDFLAGS: $(inherited) -leletrocromo -lresolv -framework CoreFoundation -framework Security
    LIBRARY_SEARCH_PATHS: $(inherited) $(PROJECT_DIR)/lib
    HEADER_SEARCH_PATHS: $(inherited) $(PROJECT_DIR)/lib
    ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
    INFOPLIST_KEY_UILaunchStoryboardName: LaunchScreen
targets:
  {{.Product}}:
    type: application
    platform: iOS
    sources:
      - path: Sources
      - path: Assets.xcassets
        buildPhase: resources
      - path: LaunchScreen.storyboard
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{.PackageID}}
        PRODUCT_NAME: {{.Product}}
        MARKETING_VERSION: "{{.VersionName}}"
        CURRENT_PROJECT_VERSION: "{{.CodeString}}"
        INFOPLIST_KEY_CFBundleDisplayName: "{{.AppName}}"
        INFOPLIST_KEY_LSRequiresIPhoneOS: YES
{{- if .EmbedShare}}
    dependencies:
      - target: {{.ShareProduct}}
        embed: true
        codeSign: true
  {{.ShareProduct}}:
    type: app-extension
    platform: iOS
    sources:
      - path: ShareExtension
        excludes:
          - Info.plist
          - "*.entitlements"
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{.PackageID}}.share
        PRODUCT_NAME: {{.ShareProduct}}
        INFOPLIST_FILE: ShareExtension/Info.plist
        GENERATE_INFOPLIST_FILE: NO
        IPHONEOS_DEPLOYMENT_TARGET: "17.0"
        CODE_SIGN_IDENTITY: "-"
        CODE_SIGNING_REQUIRED: NO
        CODE_SIGNING_ALLOWED: YES
        AD_HOC_CODE_SIGNING_ALLOWED: YES
        CODE_SIGN_ENTITLEMENTS: ShareExtension/Share.entitlements
        SKIP_INSTALL: YES
        LD_RUNPATH_SEARCH_PATHS: "$(inherited) @executable_path/Frameworks @executable_path/../../Frameworks"
{{- end}}
