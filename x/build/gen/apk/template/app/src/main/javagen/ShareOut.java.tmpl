package {{.PackageID}};

import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.os.Handler;
import android.os.Looper;
import android.webkit.MimeTypeMap;

import lewkit.FileProvider;

import org.json.JSONArray;
import org.json.JSONObject;

import java.io.File;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.io.UncheckedIOException;
import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

/** Tails cache/share.jsonl and starts the system share sheet. */
public final class ShareOut {
    private static final Handler main = new Handler(Looper.getMainLooper());
    private static long offset;
    private static boolean started;

    private ShareOut() {}

    public static void start(Context ctx) {
        if (started) {
            return;
        }
        started = true;
        Context app = ctx.getApplicationContext();
        // Lines already in the file belong to an earlier process. A launch
        // that replays them opens the share sheet before the app is ready.
        File existing = new File(app.getCacheDir(), "share.jsonl");
        if (existing.isFile()) {
            offset = existing.length();
        }
        Thread worker = new Thread(() -> {
            while (true) {
                poll(app);
                try {
                    Thread.sleep(200);
                } catch (InterruptedException e) {
                    return;
                }
            }
        }, "eletrocromo-share");
        worker.setDaemon(true);
        worker.start();
    }

    private static void poll(Context ctx) {
        File file = new File(ctx.getCacheDir(), "share.jsonl");
        if (!file.exists()) {
            return;
        }
        try (RandomAccessFile raf = new RandomAccessFile(file, "r")) {
            if (raf.length() < offset) {
                offset = 0;
            }
            raf.seek(offset);
            String line;
            while ((line = raf.readLine()) != null) {
                Item parsed = parse(line);
                if (parsed == null) {
                    continue;
                }
                main.post(() -> launch(ctx, parsed));
            }
            offset = raf.getFilePointer();
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }

    private static final class Item {
        final String text;
        final String url;
        final List<String> paths;

        Item(String text, String url, List<String> paths) {
            this.text = text;
            this.url = url;
            this.paths = paths;
        }
    }

    private static Item parse(String line) {
        try {
            JSONObject o = new JSONObject(line);
            List<String> paths = new ArrayList<>();
            if (o.has("paths")) {
                JSONArray arr = o.getJSONArray("paths");
                for (int i = 0; i < arr.length(); i++) {
                    paths.add(arr.getString(i));
                }
            }
            return new Item(o.optString("text"), o.optString("url"), paths);
        } catch (Exception e) {
            return null;
        }
    }

    private static void launch(Context ctx, Item item) {
        Intent send = new Intent(item.paths.size() > 1 ? Intent.ACTION_SEND_MULTIPLE : Intent.ACTION_SEND);
        send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
        send.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
        if (!item.paths.isEmpty()) {
            ArrayList<Uri> uris = new ArrayList<>();
            for (String path : item.paths) {
                uris.add(FileProvider.getUriForFile(
                        ctx, ctx.getPackageName() + ".fileprovider", new File(path)));
            }
            send.setType(mimeOf(item.paths.get(0)));
            if (uris.size() == 1) {
                send.putExtra(Intent.EXTRA_STREAM, uris.get(0));
            } else {
                send.putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris);
            }
        } else {
            send.setType("text/plain");
            String text = item.text;
            if (text == null || text.trim().isEmpty()) {
                text = item.url;
            }
            send.putExtra(Intent.EXTRA_TEXT, text);
        }
        Intent chooser = Intent.createChooser(send, null);
        chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
        ctx.startActivity(chooser);
    }

    private static String mimeOf(String path) {
        String name = new File(path).getName();
        int dot = name.lastIndexOf('.');
        String ext = dot >= 0 ? name.substring(dot + 1).toLowerCase(Locale.ROOT) : "";
        String mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext);
        if (mime == null) {
            return "application/octet-stream";
        }
        return mime;
    }
}
