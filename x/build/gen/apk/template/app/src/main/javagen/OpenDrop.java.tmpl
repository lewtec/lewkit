package {{.PackageID}};

import android.content.Context;
import android.content.Intent;
import android.database.Cursor;
import android.net.Uri;
import android.os.Build;
import android.provider.OpenableColumns;

import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.io.UncheckedIOException;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;
import java.util.Locale;
import java.util.UUID;

/**
 * Copies share/view payloads into cache/inbox and appends Cache/open.jsonl.
 * The Go process tails that file. No HTTP.
 */
public final class OpenDrop {
    private OpenDrop() {}

    public static void handle(Context ctx, Intent intent) {
        if (intent == null) {
            return;
        }
        String action = intent.getAction();
        if (Intent.ACTION_VIEW.equals(action)) {
            Uri uri = intent.getData();
            if (uri == null) {
                return;
            }
            if (isCustomScheme(uri)) {
                append(ctx, "{\"kind\":\"url\",\"url\":" + jsonStr(uri.toString()) + "}");
            } else {
                String path = materialize(ctx, uri);
                if (path == null) {
                    return;
                }
                append(ctx, "{\"kind\":\"files\",\"paths\":[" + jsonStr(path) + "]}");
            }
            return;
        }
        if (Intent.ACTION_SEND.equals(action)) {
            Uri uri = streamUri(intent);
            if (uri == null) {
                return;
            }
            String path = materialize(ctx, uri);
            if (path == null) {
                return;
            }
            append(ctx, "{\"kind\":\"files\",\"paths\":[" + jsonStr(path) + "]}");
            return;
        }
        if (Intent.ACTION_SEND_MULTIPLE.equals(action)) {
            List<Uri> uris = streamUris(intent);
            StringBuilder paths = new StringBuilder();
            for (Uri uri : uris) {
                String path = materialize(ctx, uri);
                if (path == null) {
                    continue;
                }
                if (paths.length() > 0) {
                    paths.append(',');
                }
                paths.append(jsonStr(path));
            }
            if (paths.length() == 0) {
                return;
            }
            append(ctx, "{\"kind\":\"files\",\"paths\":[" + paths + "]}");
        }
    }

    @SuppressWarnings("deprecation")
    private static Uri streamUri(Intent intent) {
        if (Build.VERSION.SDK_INT >= 33) {
            return intent.getParcelableExtra(Intent.EXTRA_STREAM, Uri.class);
        }
        return intent.getParcelableExtra(Intent.EXTRA_STREAM);
    }

    @SuppressWarnings("deprecation")
    private static List<Uri> streamUris(Intent intent) {
        ArrayList<Uri> list;
        if (Build.VERSION.SDK_INT >= 33) {
            list = intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM, Uri.class);
        } else {
            list = intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM);
        }
        if (list == null) {
            return new ArrayList<>();
        }
        return list;
    }

    private static boolean isCustomScheme(Uri uri) {
        String scheme = uri.getScheme();
        if (scheme == null) {
            return false;
        }
        scheme = scheme.toLowerCase(Locale.ROOT);
        return !scheme.equals("http") && !scheme.equals("https")
                && !scheme.equals("content") && !scheme.equals("file");
    }

    private static String materialize(Context ctx, Uri uri) {
        File inbox = new File(ctx.getCacheDir(), "inbox");
        if (!inbox.mkdirs() && !inbox.isDirectory()) {
            return null;
        }
        String name = displayName(ctx, uri);
        if (name == null) {
            name = "open.bin";
        }
        File dest = new File(inbox, UUID.randomUUID() + "-" + new File(name).getName());
        try (InputStream input = ctx.getContentResolver().openInputStream(uri)) {
            if (input == null) {
                return null;
            }
            try (OutputStream output = new FileOutputStream(dest)) {
                byte[] buf = new byte[8192];
                int n;
                while ((n = input.read(buf)) >= 0) {
                    output.write(buf, 0, n);
                }
            }
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
        return dest.getAbsolutePath();
    }

    private static String displayName(Context ctx, Uri uri) {
        if ("content".equals(uri.getScheme())) {
            try (Cursor c = ctx.getContentResolver().query(
                    uri, new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
                if (c != null && c.moveToFirst()) {
                    int i = c.getColumnIndex(OpenableColumns.DISPLAY_NAME);
                    if (i >= 0) {
                        return c.getString(i);
                    }
                }
            }
        }
        return uri.getLastPathSegment();
    }

    private static void append(Context ctx, String line) {
        File file = new File(ctx.getCacheDir(), "open.jsonl");
        try (FileOutputStream out = new FileOutputStream(file, true)) {
            out.write((line + "\n").getBytes(StandardCharsets.UTF_8));
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }

    private static String jsonStr(String s) {
        StringBuilder b = new StringBuilder("\"");
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    b.append(ch);
                    break;
            }
        }
        return b.append('"').toString();
    }
}
