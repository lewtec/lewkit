package {{.PackageID}}

import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Build
import android.provider.OpenableColumns
import java.io.File
import java.util.UUID

/**
 * Copies share/view payloads into cache/inbox and appends Cache/open.jsonl.
 * The Go process tails that file. No HTTP.
 */
object OpenDrop {
    fun handle(ctx: Context, intent: Intent?) {
        if (intent == null) return
        when (intent.action) {
            Intent.ACTION_VIEW -> {
                val uri = intent.data ?: return
                if (isCustomScheme(uri)) {
                    append(ctx, """{"kind":"url","url":${jsonStr(uri.toString())}}""")
                } else {
                    val path = materialize(ctx, uri) ?: return
                    append(ctx, """{"kind":"files","paths":[${jsonStr(path)}]}""")
                }
            }
            Intent.ACTION_SEND -> {
                val uri = streamUri(intent) ?: return
                val path = materialize(ctx, uri) ?: return
                append(ctx, """{"kind":"files","paths":[${jsonStr(path)}]}""")
            }
            Intent.ACTION_SEND_MULTIPLE -> {
                val uris = streamUris(intent)
                val paths = uris.mapNotNull { materialize(ctx, it) }
                if (paths.isEmpty()) return
                append(ctx, """{"kind":"files","paths":[${paths.joinToString(",") { jsonStr(it) }}]}""")
            }
        }
    }

    private fun streamUri(intent: Intent): Uri? {
        return if (Build.VERSION.SDK_INT >= 33) {
            intent.getParcelableExtra(Intent.EXTRA_STREAM, Uri::class.java)
        } else {
            @Suppress("DEPRECATION")
            intent.getParcelableExtra(Intent.EXTRA_STREAM)
        }
    }

    private fun streamUris(intent: Intent): List<Uri> {
        val list = if (Build.VERSION.SDK_INT >= 33) {
            intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM, Uri::class.java)
        } else {
            @Suppress("DEPRECATION")
            intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM)
        }
        return list ?: emptyList()
    }

    private fun isCustomScheme(uri: Uri): Boolean {
        val s = uri.scheme?.lowercase() ?: return false
        return s != "http" && s != "https" && s != "content" && s != "file"
    }

    private fun materialize(ctx: Context, uri: Uri): String? {
        val inbox = File(ctx.cacheDir, "inbox")
        if (!inbox.mkdirs() && !inbox.isDirectory) return null
        val name = displayName(ctx, uri) ?: "open.bin"
        val dest = File(inbox, UUID.randomUUID().toString() + "-" + File(name).name)
        ctx.contentResolver.openInputStream(uri)?.use { input ->
            dest.outputStream().use { output -> input.copyTo(output) }
        } ?: return null
        return dest.absolutePath
    }

    private fun displayName(ctx: Context, uri: Uri): String? {
        if (uri.scheme == "content") {
            ctx.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)
                ?.use { c ->
                    if (c.moveToFirst()) {
                        val i = c.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                        if (i >= 0) return c.getString(i)
                    }
                }
        }
        return uri.lastPathSegment
    }

    private fun append(ctx: Context, line: String) {
        File(ctx.cacheDir, "open.jsonl").appendText(line + "\n")
    }

    private fun jsonStr(s: String): String {
        val b = StringBuilder("\"")
        for (ch in s) {
            when (ch) {
                '\\' -> b.append("\\\\")
                '"' -> b.append("\\\"")
                '\n' -> b.append("\\n")
                '\r' -> b.append("\\r")
                '\t' -> b.append("\\t")
                else -> b.append(ch)
            }
        }
        return b.append('"').toString()
    }
}
