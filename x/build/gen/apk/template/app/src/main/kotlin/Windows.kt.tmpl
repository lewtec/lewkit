package {{.PackageID}}

import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Message
import android.webkit.WebChromeClient
import android.webkit.WebResourceRequest
import android.webkit.WebView
import android.webkit.WebViewClient
import androidx.appcompat.app.AppCompatActivity

// pushWebWindow opens one webapp window. The first page and later pages use it.
internal fun pushWebWindow(context: Context, url: String) {
    context.startActivity(
        Intent(context, PageActivity::class.java)
            .putExtra(PageActivity.EXTRA_URL, url)
            .addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP),
    )
}

internal fun installStackedWindows(activity: AppCompatActivity, webView: WebView) {
    webView.settings.setSupportMultipleWindows(true)
    webView.settings.javaScriptCanOpenWindowsAutomatically = true
    webView.webChromeClient = object : WebChromeClient() {
        override fun onCreateWindow(
            view: WebView?,
            isDialog: Boolean,
            isUserGesture: Boolean,
            resultMsg: Message?,
        ): Boolean {
            if (resultMsg == null) return false
            val child = WebView(activity)
            var handed = false
            fun hand(url: String?) {
                if (handed || url.isNullOrBlank()) return
                val uri = Uri.parse(url)
                if (!isAppUrl(uri)) return
                handed = true
                pushWebWindow(activity, uri.toString())
                child.destroy()
            }
            child.webViewClient = object : WebViewClient() {
                override fun shouldOverrideUrlLoading(view: WebView?, request: WebResourceRequest?): Boolean {
                    hand(request?.url?.toString())
                    return true
                }

                override fun onPageStarted(view: WebView?, url: String?, favicon: android.graphics.Bitmap?) {
                    hand(url)
                }
            }
            val transport = resultMsg.obj as WebView.WebViewTransport
            transport.webView = child
            resultMsg.sendToTarget()
            return true
        }
    }
}

internal fun isAppUrl(uri: Uri): Boolean {
    val host = uri.host?.lowercase() ?: return false
    return host == "127.0.0.1" || host == "localhost" || host == "::1"
}
