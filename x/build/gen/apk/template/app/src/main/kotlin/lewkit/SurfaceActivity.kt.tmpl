package lewkit

import android.content.res.Configuration
import android.graphics.PixelFormat
import android.os.Bundle
import android.view.MotionEvent
import android.view.SurfaceHolder
import android.view.SurfaceView
import androidx.appcompat.app.AppCompatActivity

/** A Vulkan surface window. The Go app presents into the native window. */
class SurfaceActivity : AppCompatActivity(), SurfaceHolder.Callback {
    private var sent = false
    private var alive = false
    private var lastW = 0
    private var lastH = 0

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val view = SurfaceView(this)
        view.setZOrderOnTop(true)
        view.isClickable = true
        view.setOnTouchListener { _, event ->
            val action = when (event.actionMasked) {
                MotionEvent.ACTION_DOWN -> 0
                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> 1
                MotionEvent.ACTION_MOVE -> 2
                else -> return@setOnTouchListener false
            }
            Host.pointer(event.x.toInt(), event.y.toInt(), action)
            true
        }
        setContentView(view)
        view.holder.setFormat(PixelFormat.OPAQUE)
        view.holder.addCallback(this)
    }

    override fun onConfigurationChanged(newConfig: Configuration) {
        super.onConfigurationChanged(newConfig)
        findViewById<android.view.View>(android.R.id.content)?.requestLayout()
    }

    override fun surfaceCreated(holder: SurfaceHolder) {}

    override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {
        if (width < 64 || height < 64) return
        val same = sent && alive && width == lastW && height == lastH
        lastW = width
        lastH = height
        alive = true
        if (!sent) {
            sent = true
            Host.nativeWindow(holder.surface, width, height)
            return
        }
        if (same) return
        Host.nativeWindow(holder.surface, width, height)
    }

    override fun surfaceDestroyed(holder: SurfaceHolder) {
        alive = false
        Host.surfaceLost()
    }
}
