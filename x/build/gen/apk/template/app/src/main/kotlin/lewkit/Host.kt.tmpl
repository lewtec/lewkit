package lewkit

import android.Manifest
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.view.Surface
import androidx.core.app.NotificationCompat
import androidx.core.content.ContextCompat
import java.util.concurrent.CountDownLatch
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference

object Host {
    @Volatile
    var app: Context? = null

    var onReady: ((String) -> Unit)? = null
    var onFail: ((String) -> Unit)? = null

    fun load() {
        System.loadLibrary("eletrocromo")
    }

    @Volatile
    var foreground: android.app.Activity? = null

    fun noteForeground(activity: android.app.Activity, visible: Boolean) {
        if (visible) {
            foreground = activity
        } else if (foreground === activity) {
            foreground = null
        }
    }

    @JvmStatic
    fun openSurface() {
        Handler(Looper.getMainLooper()).post {
            val fg = foreground
            if (fg != null) {
                fg.startActivity(Intent(fg, SurfaceActivity::class.java))
                return@post
            }
            val ctx = app ?: return@post
            ctx.startActivity(
                Intent(ctx, SurfaceActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
            )
        }
    }

    @JvmStatic
    fun ready(url: String) {
        val cb = onReady ?: return
        Handler(Looper.getMainLooper()).post { cb(url) }
    }

    @JvmStatic
    fun fail(message: String) {
        val cb = onFail ?: return
        Handler(Looper.getMainLooper()).post { cb(message) }
    }

    @JvmStatic
    fun dataDir(): String {
        val ctx = app ?: return ""
        return ctx.filesDir.absolutePath
    }

    @JvmStatic
    fun cacheDir(): String {
        val ctx = app ?: return ""
        return ctx.cacheDir.absolutePath
    }

    @JvmStatic
    fun configDir(): String {
        val ctx = app ?: return ""
        val dir = java.io.File(ctx.filesDir, "config")
        dir.mkdirs()
        return dir.absolutePath
    }

    private val nextNotificationID = AtomicInteger(1000)

    @JvmStatic
    fun notify(id: String, title: String, message: String, urgency: String, progress: String): String {
        val ctx = app ?: return "android host has no context"
        if (Looper.myLooper() == Looper.getMainLooper()) {
            return deliver(ctx, id, title, message, urgency, progress)
        }
        val result = AtomicReference("")
        val latch = CountDownLatch(1)
        Handler(Looper.getMainLooper()).post {
            try {
                result.set(deliver(ctx, id, title, message, urgency, progress))
            } catch (err: RuntimeException) {
                result.set(err.message ?: "android notification failed")
            } finally {
                latch.countDown()
            }
        }
        return try {
            if (!latch.await(2, TimeUnit.SECONDS)) {
                "android notification timed out"
            } else {
                result.get()
            }
        } catch (_: InterruptedException) {
            "android notification interrupted"
        }
    }

    private fun deliver(
        ctx: Context,
        id: String,
        title: String,
        message: String,
        urgency: String,
        progress: String,
    ): String {
        if (Build.VERSION.SDK_INT >= 33 &&
            ContextCompat.checkSelfPermission(ctx, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
        ) {
            try {
                foreground?.requestPermissions(
                    arrayOf(Manifest.permission.POST_NOTIFICATIONS),
                    REQUEST_POST_NOTIFICATIONS,
                )
            } catch (_: IllegalStateException) {
                return "notification permission required"
            }
            return "notification permission required"
        }
        val parsed = id.toLongOrNull() ?: 0L
        val nid = notificationID(parsed)
        val channel = when (urgency) {
            "low" -> "lewkit_low"
            "critical" -> "lewkit_critical"
            else -> "lewkit_normal"
        }
        val importance = when (urgency) {
            "low" -> NotificationManager.IMPORTANCE_LOW
            "critical" -> NotificationManager.IMPORTANCE_HIGH
            else -> NotificationManager.IMPORTANCE_DEFAULT
        }
        val nm = ctx.getSystemService(NotificationManager::class.java)
            ?: return "notification manager missing"
        val label = ctx.applicationInfo.loadLabel(ctx.packageManager).toString()
        val channelName = when (urgency) {
            "low" -> "$label low"
            "critical" -> "$label critical"
            else -> label
        }
        nm.createNotificationChannel(NotificationChannel(channel, channelName, importance))
        val icon = ctx.applicationInfo.icon.takeIf { it != 0 } ?: android.R.drawable.stat_notify_chat
        val builder = NotificationCompat.Builder(ctx, channel)
            .setContentTitle(title)
            .setContentText(message)
            .setSmallIcon(icon)
            .setAutoCancel(true)
            .setPriority(
                when (urgency) {
                    "low" -> NotificationCompat.PRIORITY_LOW
                    "critical" -> NotificationCompat.PRIORITY_HIGH
                    else -> NotificationCompat.PRIORITY_DEFAULT
                },
            )
        if (parsed != 0L || progress.isNotEmpty()) {
            builder.setOnlyAlertOnce(true)
        }
        ctx.packageManager.getLaunchIntentForPackage(ctx.packageName)?.let { launch ->
            val pending = PendingIntent.getActivity(
                ctx,
                0,
                launch,
                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
            )
            builder.setContentIntent(pending)
        }
        if (progress.isNotEmpty()) {
            val value = progress.toIntOrNull()?.coerceIn(0, 100) ?: 0
            builder.setProgress(100, value, false)
        }
        nm.notify(nid, builder.build())
        return ""
    }

    private fun notificationID(parsed: Long): Int {
        if (parsed == 0L) {
            return nextNotificationID.getAndIncrement()
        }
        val id = (parsed and 0x7fffffffL).toInt()
        if (id == 0) {
            return nextNotificationID.getAndIncrement()
        }
        return id
    }

    @JvmStatic
    external fun start(readyFile: String)

    @JvmStatic
    external fun nativeWindow(surface: Surface?, width: Int, height: Int): Long

    @JvmStatic
    external fun pointer(x: Int, y: Int, action: Int)

    @JvmStatic
    external fun resize(width: Int, height: Int)

    @JvmStatic
    external fun surfaceLost()

    private const val REQUEST_POST_NOTIFICATIONS = 7702
}
