package lewkit

import android.content.Context
import android.content.Intent
import android.os.Handler
import android.os.Looper
import android.view.Surface
import androidx.appcompat.app.AlertDialog
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger

object Host {
    @Volatile
    var app: Context? = null

    var onReady: ((String) -> Unit)? = null
    var onFail: ((String) -> Unit)? = null

    fun load() {
        System.loadLibrary("eletrocromo")
    }

    @Volatile
    var foreground: android.app.Activity? = null

    fun noteForeground(activity: android.app.Activity, visible: Boolean) {
        if (visible) {
            foreground = activity
        } else if (foreground === activity) {
            foreground = null
        }
    }

    @JvmStatic
    fun openSurface() {
        Handler(Looper.getMainLooper()).post {
            val fg = foreground
            if (fg != null) {
                fg.startActivity(Intent(fg, SurfaceActivity::class.java))
                return@post
            }
            val ctx = app ?: return@post
            ctx.startActivity(
                Intent(ctx, SurfaceActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
            )
        }
    }

    @JvmStatic
    fun ready(url: String) {
        val cb = onReady ?: return
        Handler(Looper.getMainLooper()).post { cb(url) }
    }

    @JvmStatic
    fun fail(message: String) {
        val cb = onFail ?: return
        Handler(Looper.getMainLooper()).post { cb(message) }
    }

    @JvmStatic
    fun dataDir(): String {
        val ctx = app ?: return ""
        return ctx.filesDir.absolutePath
    }

    @JvmStatic
    fun cacheDir(): String {
        val ctx = app ?: return ""
        return ctx.cacheDir.absolutePath
    }

    @JvmStatic
    fun configDir(): String {
        val ctx = app ?: return ""
        val dir = java.io.File(ctx.filesDir, "config")
        dir.mkdirs()
        return dir.absolutePath
    }

    private var confirmDialog: AlertDialog? = null
    private val confirmSeq = AtomicInteger()

    // confirmResult codes: 0 no, 1 yes, 2 no foreground activity.
    @JvmStatic
    fun confirm(message: String) {
        val id = confirmSeq.incrementAndGet()
        Handler(Looper.getMainLooper()).post { showConfirm(id, message) }
    }

    @JvmStatic
    fun dismissConfirm() {
        confirmSeq.incrementAndGet()
        Handler(Looper.getMainLooper()).post {
            val dialog = confirmDialog ?: return@post
            confirmDialog = null
            dialog.setOnCancelListener(null)
            dialog.dismiss()
        }
    }

    private fun showConfirm(id: Int, message: String) {
        if (id != confirmSeq.get()) {
            return
        }
        confirmDialog?.setOnCancelListener(null)
        confirmDialog?.dismiss()
        confirmDialog = null
        val activity = foreground
        if (activity == null || activity.isFinishing || activity.isDestroyed) {
            confirmResult(2)
            return
        }
        val once = AtomicBoolean(false)
        fun finish(code: Int) {
            if (id != confirmSeq.get() || !once.compareAndSet(false, true)) {
                return
            }
            confirmDialog = null
            confirmResult(code)
        }
        val dialog = AlertDialog.Builder(activity)
            .setMessage(message)
            .setPositiveButton(android.R.string.yes) { _, _ -> finish(1) }
            .setNegativeButton(android.R.string.no) { _, _ -> finish(0) }
            .setOnCancelListener { finish(0) }
            .create()
        confirmDialog = dialog
        try {
            dialog.show()
        } catch (_: RuntimeException) {
            confirmDialog = null
            finish(2)
        }
    }

    @JvmStatic
    external fun start(readyFile: String)

    @JvmStatic
    external fun nativeWindow(surface: Surface?, width: Int, height: Int): Long

    @JvmStatic
    external fun pointer(x: Int, y: Int, action: Int)

    @JvmStatic
    external fun resize(width: Int, height: Int)

    @JvmStatic
    external fun surfaceLost()

    @JvmStatic
    external fun confirmResult(code: Int)
}
