package lewkit

import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.os.BatteryManager
import android.os.Handler
import android.os.Looper
import android.view.Surface
import androidx.core.content.ContextCompat

object Host {
    @Volatile
    var app: Context? = null

    var onReady: ((String) -> Unit)? = null
    var onFail: ((String) -> Unit)? = null

    fun load() {
        System.loadLibrary("eletrocromo")
    }

    @Volatile
    var foreground: android.app.Activity? = null

    fun noteForeground(activity: android.app.Activity, visible: Boolean) {
        if (visible) {
            foreground = activity
        } else if (foreground === activity) {
            foreground = null
        }
    }

    @JvmStatic
    fun openSurface() {
        Handler(Looper.getMainLooper()).post {
            val fg = foreground
            if (fg != null) {
                fg.startActivity(Intent(fg, SurfaceActivity::class.java))
                return@post
            }
            val ctx = app ?: return@post
            ctx.startActivity(
                Intent(ctx, SurfaceActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
            )
        }
    }

    @JvmStatic
    fun ready(url: String) {
        val cb = onReady ?: return
        Handler(Looper.getMainLooper()).post { cb(url) }
    }

    @JvmStatic
    fun fail(message: String) {
        val cb = onFail ?: return
        Handler(Looper.getMainLooper()).post { cb(message) }
    }

    @JvmStatic
    fun dataDir(): String {
        val ctx = app ?: return ""
        return ctx.filesDir.absolutePath
    }

    @JvmStatic
    fun cacheDir(): String {
        val ctx = app ?: return ""
        return ctx.cacheDir.absolutePath
    }

    @JvmStatic
    fun configDir(): String {
        val ctx = app ?: return ""
        val dir = java.io.File(ctx.filesDir, "config")
        dir.mkdirs()
        return dir.absolutePath
    }

    @JvmStatic
    fun batteryStatus(): String {
        val ctx = app ?: return ""
        val intent = ContextCompat.registerReceiver(
            ctx,
            null,
            IntentFilter(Intent.ACTION_BATTERY_CHANGED),
            ContextCompat.RECEIVER_NOT_EXPORTED,
        ) ?: return ""
        // A missing EXTRA_PRESENT still reports status. False means no battery.
        if (!intent.getBooleanExtra(BatteryManager.EXTRA_PRESENT, true)) {
            return ""
        }
        return when (intent.getIntExtra(BatteryManager.EXTRA_STATUS, BatteryManager.BATTERY_STATUS_UNKNOWN)) {
            BatteryManager.BATTERY_STATUS_CHARGING -> "Charging"
            BatteryManager.BATTERY_STATUS_DISCHARGING -> "Discharging"
            BatteryManager.BATTERY_STATUS_FULL -> "Full"
            BatteryManager.BATTERY_STATUS_NOT_CHARGING -> "Not charging"
            else -> "Unknown"
        }
    }

    @JvmStatic
    external fun start(readyFile: String)

    @JvmStatic
    external fun nativeWindow(surface: Surface?, width: Int, height: Int): Long

    @JvmStatic
    external fun pointer(x: Int, y: Int, action: Int)

    @JvmStatic
    external fun resize(width: Int, height: Int)

    @JvmStatic
    external fun surfaceLost()
}
