package lewkit

import android.content.Context
import android.content.Intent
import android.os.Handler
import android.os.Looper
import android.text.InputType
import android.view.Surface
import android.view.WindowManager
import android.widget.EditText
import androidx.appcompat.app.AlertDialog
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger

object Host {
    @Volatile
    var app: Context? = null

    var onReady: ((String) -> Unit)? = null
    var onFail: ((String) -> Unit)? = null

    fun load() {
        System.loadLibrary("eletrocromo")
    }

    @Volatile
    var foreground: android.app.Activity? = null

    fun noteForeground(activity: android.app.Activity, visible: Boolean) {
        if (visible) {
            foreground = activity
        } else if (foreground === activity) {
            foreground = null
        }
    }

    @JvmStatic
    fun openSurface() {
        Handler(Looper.getMainLooper()).post {
            val fg = foreground
            if (fg != null) {
                fg.startActivity(Intent(fg, SurfaceActivity::class.java))
                return@post
            }
            val ctx = app ?: return@post
            ctx.startActivity(
                Intent(ctx, SurfaceActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
            )
        }
    }

    @JvmStatic
    fun ready(url: String) {
        val cb = onReady ?: return
        Handler(Looper.getMainLooper()).post { cb(url) }
    }

    @JvmStatic
    fun fail(message: String) {
        val cb = onFail ?: return
        Handler(Looper.getMainLooper()).post { cb(message) }
    }

    @JvmStatic
    fun dataDir(): String {
        val ctx = app ?: return ""
        return ctx.filesDir.absolutePath
    }

    @JvmStatic
    fun cacheDir(): String {
        val ctx = app ?: return ""
        return ctx.cacheDir.absolutePath
    }

    @JvmStatic
    fun configDir(): String {
        val ctx = app ?: return ""
        val dir = java.io.File(ctx.filesDir, "config")
        dir.mkdirs()
        return dir.absolutePath
    }

    private var promptDialog: AlertDialog? = null
    private val promptSeq = AtomicInteger()

    // promptResult codes: 0 canceled, 1 submitted text, 2 no foreground activity.
    @JvmStatic
    fun prompt(message: String) {
        val id = promptSeq.incrementAndGet()
        Handler(Looper.getMainLooper()).post { showPrompt(id, message) }
    }

    @JvmStatic
    fun dismissPrompt() {
        promptSeq.incrementAndGet()
        Handler(Looper.getMainLooper()).post {
            val dialog = promptDialog ?: return@post
            promptDialog = null
            dialog.setOnCancelListener(null)
            dialog.dismiss()
        }
    }

    private fun showPrompt(id: Int, message: String) {
        if (id != promptSeq.get()) {
            return
        }
        promptDialog?.setOnCancelListener(null)
        promptDialog?.dismiss()
        promptDialog = null
        val activity = foreground
        if (activity == null || activity.isFinishing || activity.isDestroyed) {
            promptResult("", 2)
            return
        }
        val once = AtomicBoolean(false)
        fun finish(text: String, code: Int) {
            if (id != promptSeq.get() || !once.compareAndSet(false, true)) {
                return
            }
            promptDialog = null
            promptResult(text, code)
        }
        val input = EditText(activity)
        input.inputType = InputType.TYPE_CLASS_TEXT
        input.isSingleLine = true
        val dialog = AlertDialog.Builder(activity)
            .setMessage(message)
            .setView(input)
            .setPositiveButton(android.R.string.ok) { _, _ ->
                finish(input.text?.toString().orEmpty(), 1)
            }
            .setNegativeButton(android.R.string.cancel) { _, _ ->
                finish("", 0)
            }
            .setOnCancelListener { finish("", 0) }
            .create()
        dialog.setOnShowListener { input.requestFocus() }
        dialog.window?.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_STATE_VISIBLE)
        promptDialog = dialog
        dialog.show()
    }

    @JvmStatic
    external fun start(readyFile: String)

    @JvmStatic
    external fun nativeWindow(surface: Surface?, width: Int, height: Int): Long

    @JvmStatic
    external fun pointer(x: Int, y: Int, action: Int)

    @JvmStatic
    external fun resize(width: Int, height: Int)

    @JvmStatic
    external fun surfaceLost()

    @JvmStatic
    external fun promptResult(text: String, code: Int)
}
