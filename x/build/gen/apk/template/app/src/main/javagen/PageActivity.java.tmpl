package {{.PackageID}};

import android.annotation.SuppressLint;
import android.content.Intent;
import android.content.res.Configuration;
import android.os.Build;
import android.os.Bundle;
import android.os.Looper;
import android.view.ViewGroup;
import android.webkit.CookieManager;
import android.webkit.WebResourceError;
import android.webkit.WebResourceRequest;
import android.webkit.WebResourceResponse;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.window.OnBackInvokedDispatcher;

import androidx.swiperefreshlayout.widget.SwipeRefreshLayout;

import lewkit.HostActivity;
import lewkit.Page;

/** One webapp window. Pull down at the top of the page to reload it. */
public class PageActivity extends HostActivity {
    public static final String EXTRA_URL = "url";
    public static final String EXTRA_PAGE = "page";

    private WebView webView;
    private SwipeRefreshLayout swipeRefresh;
    private volatile int pageId;

    @SuppressLint("SetJavaScriptEnabled")
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        int id = getIntent().getIntExtra(EXTRA_PAGE, 0);
        String url = getIntent().getStringExtra(EXTRA_URL);
        if (id == 0 && (url == null || url.trim().isEmpty())) {
            finish();
            return;
        }
        WebView wv = new WebView(this);
        webView = wv;
        SwipeRefreshLayout swipe = new SwipeRefreshLayout(this);
        swipeRefresh = swipe;
        swipe.addView(wv, new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT));
        setContentView(swipe);
        swipe.setOnRefreshListener(() -> {
            if (pageId != 0) {
                WebView current = webView;
                if (current != null) {
                    current.reload();
                }
                return;
            }
            reloadPage(url);
        });
        // The WebView is the scrolling child. A positive scroll means the
        // gesture belongs to the page, not to pull-to-refresh.
        swipe.setOnChildScrollUpCallback((parent, child) -> wv.getScrollY() > 0);
        CookieManager.getInstance().setAcceptCookie(true);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            CookieManager.getInstance().setAcceptThirdPartyCookies(wv, true);
        }
        WebSettings settings = wv.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        settings.setCacheMode(WebSettings.LOAD_DEFAULT);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            settings.setMixedContentMode(WebSettings.MIXED_CONTENT_COMPATIBILITY_MODE);
        }
        Windows.installStackedWindows(this, wv);
        wv.setWebViewClient(new WebViewClient() {
            @Override
            public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
                if (pageId == 0) {
                    return null;
                }
                return Page.intercept(pageId, request);
            }

            @Override
            public void onPageFinished(WebView view, String finished) {
                swipe.setRefreshing(false);
            }

            @Override
            public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
                if (request == null || !request.isForMainFrame()) {
                    return;
                }
                swipe.setRefreshing(false);
                String raw = request.getUrl() == null ? "" : request.getUrl().toString();
                redactUrlForDisplay(raw);
            }
        });
        if (id != 0) {
            bindPage(id);
        } else {
            wv.loadUrl(url);
        }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
                    OnBackInvokedDispatcher.PRIORITY_DEFAULT, () -> {
                        if (!goBackInWebView()) {
                            finish();
                        }
                    });
        }
    }

    @SuppressLint("AddJavascriptInterface")
    private void bindPage(int id) {
        WebView wv = webView;
        if (id == 0 || wv == null) {
            return;
        }
        if (pageId != 0 && pageId != id) {
            Page.detach(pageId);
        }
        pageId = id;
        wv.addJavascriptInterface(new Page.Js(id), "lewkitPage");
        Page.attach(id, new Page.Session() {
            @Override
            public void load(String target) {
                ui(() -> {
                    WebView current = webView;
                    if (current != null && target != null) {
                        current.loadUrl(target);
                    }
                });
            }

            @Override
            public void show(String baseUrl, String data, String mime, String encoding, String historyUrl) {
                ui(() -> {
                    WebView current = webView;
                    if (current == null) {
                        return;
                    }
                    current.loadDataWithBaseURL(baseUrl, data == null ? "" : data, mime, encoding, historyUrl);
                });
            }

            @Override
            public void run(String script, String token) {
                ui(() -> {
                    WebView current = webView;
                    if (current == null) {
                        Page.result(pageId, token, "");
                        return;
                    }
                    current.evaluateJavascript(script, value -> Page.result(pageId, token, value == null ? "" : value));
                });
            }

            @Override
            public void dark(boolean on) {
                ui(() -> applyDark(on));
            }

            @Override
            public void finish() {
                ui(() -> PageActivity.this.finish());
            }
        });
    }

    private void ui(Runnable job) {
        if (Looper.myLooper() == Looper.getMainLooper()) {
            job.run();
            return;
        }
        runOnUiThread(job);
    }

    @SuppressWarnings("deprecation")
    private void applyDark(boolean on) {
        WebView wv = webView;
        if (wv == null || Build.VERSION.SDK_INT < 29) {
            return;
        }
        wv.getSettings().setForceDark(on ? WebSettings.FORCE_DARK_ON : WebSettings.FORCE_DARK_OFF);
    }

    private boolean goBackInWebView() {
        if (webView != null && webView.canGoBack()) {
            webView.goBack();
            return true;
        }
        return false;
    }

    @SuppressWarnings("deprecation")
    @Override
    public void onBackPressed() {
        if (goBackInWebView()) {
            return;
        }
        super.onBackPressed();
    }

    private void reloadPage(String fallback) {
        WebView wv = webView;
        if (wv == null) {
            if (swipeRefresh != null) {
                swipeRefresh.setRefreshing(false);
            }
            return;
        }
        String current = wv.getUrl();
        if (current == null || current.trim().isEmpty()) {
            current = fallback;
        }
        wv.loadUrl(current);
    }

    @Override
    public void onConfigurationChanged(Configuration newConfig) {
        super.onConfigurationChanged(newConfig);
        if (webView != null) {
            webView.requestLayout();
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        WebView wv = webView;
        if (wv != null) {
            wv.onResume();
            wv.resumeTimers();
        }
    }

    @Override
    protected void onPause() {
        WebView wv = webView;
        if (wv != null) {
            wv.onPause();
        }
        super.onPause();
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        int id = intent.getIntExtra(EXTRA_PAGE, 0);
        if (id != 0) {
            bindPage(id);
            return;
        }
        if (pageId != 0) {
            Page.detach(pageId);
            pageId = 0;
        }
        String url = intent.getStringExtra(EXTRA_URL);
        if (url == null || webView == null) {
            return;
        }
        webView.loadUrl(url);
    }

    private String redactUrlForDisplay(String raw) {
        if (raw == null || raw.trim().isEmpty()) {
            return raw;
        }
        String noFrag = raw;
        int hash = noFrag.indexOf('#');
        if (hash >= 0) {
            noFrag = noFrag.substring(0, hash);
        }
        int query = noFrag.indexOf('?');
        if (query >= 0) {
            noFrag = noFrag.substring(0, query);
        }
        return noFrag;
    }

    @Override
    protected void onDestroy() {
        int id = pageId;
        pageId = 0;
        if (id != 0) {
            Page.detach(id);
        }
        if (webView != null) {
            webView.destroy();
            webView = null;
        }
        super.onDestroy();
    }
}
