package {{.PackageID}};

import android.annotation.SuppressLint;
import android.content.Intent;
import android.content.res.Configuration;
import android.os.Build;
import android.os.Bundle;
import android.webkit.CookieManager;
import android.webkit.WebResourceError;
import android.webkit.WebResourceRequest;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;

import androidx.appcompat.app.AppCompatActivity;

import lewkit.Host;

/** One webapp window. App start and later launches both push this activity. */
public class PageActivity extends AppCompatActivity {
    public static final String EXTRA_URL = "url";

    private WebView webView;

    @SuppressLint("SetJavaScriptEnabled")
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        String url = getIntent().getStringExtra(EXTRA_URL);
        if (url == null || url.trim().isEmpty()) {
            finish();
            return;
        }
        WebView wv = new WebView(this);
        webView = wv;
        setContentView(wv);
        CookieManager.getInstance().setAcceptCookie(true);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            CookieManager.getInstance().setAcceptThirdPartyCookies(wv, true);
        }
        WebSettings settings = wv.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        settings.setCacheMode(WebSettings.LOAD_DEFAULT);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            settings.setMixedContentMode(WebSettings.MIXED_CONTENT_COMPATIBILITY_MODE);
        }
        Windows.installStackedWindows(this, wv);
        wv.setWebViewClient(new WebViewClient() {
            @Override
            public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
                if (request == null || !request.isForMainFrame()) {
                    return;
                }
                String raw = request.getUrl() == null ? "" : request.getUrl().toString();
                redactUrlForDisplay(raw);
            }
        });
        wv.loadUrl(url);
    }

    @Override
    public void onConfigurationChanged(Configuration newConfig) {
        super.onConfigurationChanged(newConfig);
        if (webView != null) {
            webView.requestLayout();
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        Host.noteForeground(this, true);
    }

    @Override
    protected void onPause() {
        Host.noteForeground(this, false);
        super.onPause();
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        String url = intent.getStringExtra(EXTRA_URL);
        if (url == null || webView == null) {
            return;
        }
        webView.loadUrl(url);
    }

    private String redactUrlForDisplay(String raw) {
        if (raw == null || raw.trim().isEmpty()) {
            return raw;
        }
        String noFrag = raw;
        int hash = noFrag.indexOf('#');
        if (hash >= 0) {
            noFrag = noFrag.substring(0, hash);
        }
        int query = noFrag.indexOf('?');
        if (query >= 0) {
            noFrag = noFrag.substring(0, query);
        }
        return noFrag;
    }

    @Override
    protected void onDestroy() {
        if (webView != null) {
            webView.destroy();
            webView = null;
        }
        super.onDestroy();
    }
}
