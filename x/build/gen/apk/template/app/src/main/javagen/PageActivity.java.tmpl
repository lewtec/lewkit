package {{.PackageID}};

import android.annotation.SuppressLint;
import android.app.Activity;
import android.content.Intent;
import android.content.res.Configuration;
import android.os.Build;
import android.os.Bundle;
import android.view.ViewGroup;
import android.webkit.CookieManager;
import android.webkit.WebResourceError;
import android.webkit.WebResourceRequest;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.window.OnBackInvokedDispatcher;

import androidx.swiperefreshlayout.widget.SwipeRefreshLayout;

import lewkit.FileChooser;
import lewkit.Host;

/** One webapp window. Pull down at the top of the page to reload it. */
public class PageActivity extends Activity {
    public static final String EXTRA_URL = "url";

    private WebView webView;
    private SwipeRefreshLayout swipeRefresh;

    @SuppressLint("SetJavaScriptEnabled")
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        String url = getIntent().getStringExtra(EXTRA_URL);
        if (url == null || url.trim().isEmpty()) {
            finish();
            return;
        }
        WebView wv = new WebView(this);
        webView = wv;
        SwipeRefreshLayout swipe = new SwipeRefreshLayout(this);
        swipeRefresh = swipe;
        swipe.addView(wv, new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT));
        setContentView(swipe);
        swipe.setOnRefreshListener(() -> reloadPage(url));
        // The WebView is the scrolling child. A positive scroll means the
        // gesture belongs to the page, not to pull-to-refresh.
        swipe.setOnChildScrollUpCallback((parent, child) -> wv.getScrollY() > 0);
        CookieManager.getInstance().setAcceptCookie(true);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            CookieManager.getInstance().setAcceptThirdPartyCookies(wv, true);
        }
        WebSettings settings = wv.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        settings.setCacheMode(WebSettings.LOAD_DEFAULT);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            settings.setMixedContentMode(WebSettings.MIXED_CONTENT_COMPATIBILITY_MODE);
        }
        Windows.installStackedWindows(this, wv);
        wv.setWebViewClient(new WebViewClient() {
            @Override
            public void onPageFinished(WebView view, String finished) {
                swipe.setRefreshing(false);
            }

            @Override
            public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
                if (request == null || !request.isForMainFrame()) {
                    return;
                }
                swipe.setRefreshing(false);
                String raw = request.getUrl() == null ? "" : request.getUrl().toString();
                redactUrlForDisplay(raw);
            }
        });
        wv.loadUrl(url);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
                    OnBackInvokedDispatcher.PRIORITY_DEFAULT, () -> {
                        if (!goBackInWebView()) {
                            finish();
                        }
                    });
        }
    }

    private boolean goBackInWebView() {
        if (webView != null && webView.canGoBack()) {
            webView.goBack();
            return true;
        }
        return false;
    }

    @SuppressWarnings("deprecation")
    @Override
    public void onBackPressed() {
        if (goBackInWebView()) {
            return;
        }
        super.onBackPressed();
    }

    private void reloadPage(String fallback) {
        WebView wv = webView;
        if (wv == null) {
            if (swipeRefresh != null) {
                swipeRefresh.setRefreshing(false);
            }
            return;
        }
        String current = wv.getUrl();
        if (current == null || current.trim().isEmpty()) {
            current = fallback;
        }
        wv.loadUrl(current);
    }

    @Override
    public void onConfigurationChanged(Configuration newConfig) {
        super.onConfigurationChanged(newConfig);
        if (webView != null) {
            webView.requestLayout();
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        Host.noteForeground(this, true);
        WebView wv = webView;
        if (wv != null) {
            wv.onResume();
            wv.resumeTimers();
        }
    }

    @Override
    protected void onPause() {
        WebView wv = webView;
        if (wv != null) {
            wv.onPause();
        }
        Host.noteForeground(this, false);
        super.onPause();
    }

    @SuppressWarnings("deprecation")
    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        if (FileChooser.onResult(this, requestCode, resultCode, data)) {
            return;
        }
        super.onActivityResult(requestCode, resultCode, data);
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        String url = intent.getStringExtra(EXTRA_URL);
        if (url == null || webView == null) {
            return;
        }
        webView.loadUrl(url);
    }

    private String redactUrlForDisplay(String raw) {
        if (raw == null || raw.trim().isEmpty()) {
            return raw;
        }
        String noFrag = raw;
        int hash = noFrag.indexOf('#');
        if (hash >= 0) {
            noFrag = noFrag.substring(0, hash);
        }
        int query = noFrag.indexOf('?');
        if (query >= 0) {
            noFrag = noFrag.substring(0, query);
        }
        return noFrag;
    }

    @Override
    protected void onDestroy() {
        FileChooser.hostGone(this);
        if (webView != null) {
            webView.destroy();
            webView = null;
        }
        super.onDestroy();
    }
}
