package main

import "github.com/lewtec/lewkit/x/http/asset/daisyui"
import "github.com/lewtec/lewkit/x/http/asset/tailwindcss"

templ welcomeDocument(v welcomeView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.Title }</title>
			if v.Pending {
				<meta http-equiv="refresh" content="1"/>
			}
			@daisyui.Load()
			@tailwindcss.Load()
		</head>
		<body>
			<main class="max-w-lg mx-auto p-4 flex flex-col gap-4">
				<h1 class="text-xl font-semibold text-center">{ v.Title }</h1>
				if v.Pending {
					<p class="text-center opacity-70">Waiting for the picker…</p>
				}
				if v.Picked != "" {
					<p class="text-center font-mono text-sm break-all">{ v.Picked }</p>
				}
				if v.Note != "" {
					<div role="alert" class="alert">{ v.Note }</div>
				}
				if len(v.Names) > 0 {
					<ul class="list">
						for _, name := range v.Names {
							<li class="list-row">
								<span class="font-mono text-sm break-all">{ name }</span>
							</li>
						}
					</ul>
				}
				if !v.Pending {
					<form method="POST" action="/">
						<button class="btn btn-block" type="submit">Open a folder</button>
					</form>
					if len(v.Recent) > 0 {
						<ul class="list">
							for _, dir := range v.Recent {
								<li class="list-row">
									<a class="link font-mono text-sm break-all" href={ templ.URL(dir.Href) }>{ dir.Label }</a>
								</li>
							}
						</ul>
					}
				}
			</main>
		</body>
	</html>
}
